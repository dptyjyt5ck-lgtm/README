# MOCK = offline deterministic answers (no key, no network). CLAUDE = live calls to Claude.
MODEL_PROVIDER=MOCK
# Needed only for MODEL_PROVIDER=CLAUDE. Get one at https://platform.claude.com (API keys).
ANTHROPIC_API_KEY=

# run_demo.py accepts only SIMULATION_ONLY.
# autotrade.py: SIMULATION_ONLY -> paper account only; DEMO -> paper, Bybit Demo or MT5 Demo.
TRADING_MODE=SIMULATION_ONLY

# Telegram alerts (optional). Token from @BotFather, chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bybit Demo Trading key (create it while switched to Demo Trading; Read + Trade only, NO withdraw).
BYBIT_API_KEY=
BYBIT_API_SECRET=

# MT5 demo account (Windows, terminal running).
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
