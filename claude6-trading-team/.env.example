# MOCK = offline deterministic answers (no key, no network). CLAUDE = live calls to Claude.
MODEL_PROVIDER=MOCK
# Needed only for MODEL_PROVIDER=CLAUDE. Get one at https://platform.claude.com (API keys).
ANTHROPIC_API_KEY=
# The only accepted value. Anything else makes run_demo.py exit with code 2.
TRADING_MODE=SIMULATION_ONLY
